    {
      "name": "3 · Webhooks",
      "description": "CAT signs every webhook: `X-CAT-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of \"<t>.<raw body>\">` using your webhook secret. Events: `saq.submitted`, `merchant.compliant`, `merchant.expiring_soon`, `merchant.expired`, `payment_method.added`, `ping`.\n\nTo try it, set the `webhookUrl` collection variable to a test receiver (for example a free https://webhook.site URL), then run these two requests. Verify signatures with an HMAC-SHA256 over `<t>.<raw body>` and a constant-time compare.",
      "item": [
        {
          "name": "Point webhooks at your receiver",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/partner/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "partner",
                "webhook"
              ]
            },
            "description": "Sets the URL CAT delivers signed events to.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhookUrl\": \"{{webhookUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('webhookUrl')) {",
                  "  console.log('Set the webhookUrl collection variable (e.g. a https://webhook.site URL) to try webhooks.');",
                  "  if (pm.execution && pm.execution.skipRequest) pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Webhook URL saved', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send a test webhook",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/partner/webhook-test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "partner",
                "webhook-test"
              ]
            },
            "description": "Sends a signed `ping` to your receiver and reports the delivery result."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
